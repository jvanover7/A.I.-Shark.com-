# Mapbox — get token at https://account.mapbox.com/access-tokens/
# Free tier: 50k map loads / month
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Supabase — from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Open-Meteo (no key required; override if self-hosting)
OPENMETEO_BASE=https://api.open-meteo.com/v1
